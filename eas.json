{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "image": "sdk-57",
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "image": "sdk-57",
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "image": "sdk-57",
        "buildType": "apk"
      }
    },
    "production-apk": {
      "extends": "production"
    }
  }
}
